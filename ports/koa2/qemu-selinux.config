# QEMU vexpress-a9 SELinux policy30/xperms smoke only; never a Kindle config.
CONFIG_EXPERT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_AUDIT=y
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_LOCALVERSION="-koa2-headless-smoke"
# CONFIG_LAB126_PRINTK_BUFFER is not set
# CONFIG_MXC_MMA8451 is not set
