# QEMU vexpress-a9 only, never a Kindle configuration.
CONFIG_EXPERT=y
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_IPC_32BIT=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_LOCALVERSION="-koa2-headless-smoke"
# CONFIG_SECURITY is not set
# CONFIG_LAB126_PRINTK_BUFFER is not set
# CONFIG_MXC_MMA8451 is not set
