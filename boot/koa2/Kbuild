# Three modules from one source set:
# - Default (build-handoff-module.sh): staging only, no jump.
# - KOA2_EXEC=1 (build-exec-module.sh): dry-run execute candidate, stops before caches.
# - KOA2_EXEC=1 KOA2_JUMP_LIVE=1 (build-jump-module.sh): live Stage F jump module.
ifdef KOA2_EXEC
obj-m := koa2_handoff_exec.o
koa2_handoff_exec-y := stage.o contract.o plan.o fdt-rewrite.o copylist.o quiesce-verify.o marker.o jump-params.o sha256.o jump.o
ccflags-y := -I$(src) -Werror -DKOA2_EXEC_BUILD -DKOA2_JUMP_BUILD
asflags-y := -DKOA2_JUMP_BUILD
ifdef KOA2_JUMP_LIVE
obj-m := koa2_handoff_jump.o
koa2_handoff_jump-y := $(koa2_handoff_exec-y)
ccflags-y += -DKOA2_JUMP_LIVE
endif
else
obj-m := koa2_handoff_stage.o
koa2_handoff_stage-y := stage.o contract.o plan.o fdt-rewrite.o copylist.o quiesce-verify.o marker.o sha256.o
ccflags-y := -I$(src) -Werror
endif
