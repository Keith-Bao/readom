# Kindle Oasis 2 (KOA2) Cypress cyttsp5_mt touchscreen input device configuration.
# Verified from stock runtime DTB (tsc@24/cy,core/cy,mt: cy,inp_dev_name="cyttsp5_mt")
# and live device reports (/dev/input/event9).
device.internal = 1
touch.deviceType = touchScreen
touch.orientationAware = 1
